@model List<AuditEvent>
@{
    ViewData["Title"] = "Nhật ký bảo mật";
    int allowed = (int)(ViewBag.Allowed ?? 0);
    int denied = (int)(ViewBag.Denied ?? 0);
    int all = allowed + denied;
    var allowedPct = all == 0 ? 0.0 : 100.0 * allowed / all;
    var deniedPct = all == 0 ? 0.0 : 100.0 * denied / all;
}
<p class="eyebrow">QUẢN TRỊ HỆ THỐNG</p>
<h1 class="page-title">Nhật ký bảo mật</h1>
<p class="lead">Theo dõi sự kiện truy cập, xử lý và các yêu cầu bị hệ thống từ chối.</p>
<div class="grid">
    <div class="kpi"><div class="caption">Tổng sự kiện</div><div class="number">@all</div></div>
    <div class="kpi"><div class="caption">ALLOW</div><div class="number" style="color:#159776">@allowed</div></div>
    <div class="kpi"><div class="caption">DENY / BLOCKED</div><div class="number" style="color:#d4515e">@denied</div></div>
    <div class="kpi"><div class="caption">Tỉ lệ từ chối</div><div class="number">@deniedPct.ToString("0.0")%</div></div>
</div>
<div class="card"><h2>Phân bố kết quả truy cập</h2>
<div class="statbar" style="height:24px"><span class="ok" style="width:@(allowedPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span><span class="no" style="width:@(deniedPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%"></span></div>
<p class="small muted">Cho phép: @allowed | Từ chối: @denied. Số liệu tổng hợp từ nhật ký ứng dụng.</p>
</div>
<div class="card"><div class="space-between"><h2>Danh sách sự kiện</h2><form method="get" class="inline-form"><select name="action" aria-label="Lọc sự kiện"><option value="">Tất cả sự kiện</option><option value="TICKET_ACCESS_DENIED">TICKET_ACCESS_DENIED</option><option value="LOGIN_FAILED">LOGIN_FAILED</option><option value="TICKET_TRANSFER">TICKET_TRANSFER</option><option value="ATTACHMENT_UPLOAD">ATTACHMENT_UPLOAD</option><option value="TICKET_ASSIGN">TICKET_ASSIGN</option></select><button type="submit">Lọc</button></form></div>
<div class="table-wrap"><table><thead><tr><th>UTC</th><th>Người thực hiện</th><th>Hành động</th><th>Yêu cầu</th><th>Kết quả</th><th>Chi tiết</th></tr></thead><tbody>
@foreach (var e in Model)
{
    <tr><td class="no-wrap">@e.CreatedUtc.ToString("dd/MM HH:mm:ss")</td><td>@(e.ActorId?.ToString() ?? "Guest")</td><td><strong>@e.Action</strong></td><td>@(e.TicketId?.ToString() ?? "—")</td><td><span class="badge @(e.Success ? "green" : "red")">@(e.Success ? "ALLOW" : "DENY")</span></td><td>@e.Details</td></tr>
}
</tbody></table></div>@if(Model.Count==0){<div class="empty">Chưa có sự kiện phù hợp.</div>}</div>

