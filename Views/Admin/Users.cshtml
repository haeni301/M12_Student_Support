@model List<UserSummary>
@{ ViewData["Title"] = "Quản lý tài khoản"; }
<p class="eyebrow">QUẢN TRỊ NGƯỜI DÙNG</p><h1 class="page-title">Danh sách tài khoản</h1>
<p class="lead">Thông tin tài khoản, vai trò và bộ phận được quản lý tập trung.</p>
<div class="card"><div class="table-wrap"><table><thead><tr><th>ID</th><th>Tài khoản</th><th>Họ tên</th><th>Vai trò</th><th>Đơn vị</th><th>Mã SV</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var u in Model)
{
    <tr><td>@u.Id</td><td><strong>@u.UserName</strong></td><td>@u.FullName</td><td><span class="badge">@UiLabels.Role(u.Role)</span></td><td>@(u.DepartmentId?.ToString() ?? "—")</td><td>@(u.StudentCode ?? "—")</td><td><span class="badge @(u.IsActive ? "green" : "red")">@(u.IsActive ? "Hoạt động" : "Ngừng hoạt động")</span></td></tr>
}
</tbody></table></div></div>
